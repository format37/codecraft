# Copy to .env (git-ignored). docker compose reads it; the venv CLI reads the same variables from the shell.
CW_WEB_PORT=8080               # or ADDRESS:PORT to publish on one address only, e.g. 10.66.0.2:8090 (a VPN)
                               # an address that comes up after Docker needs net.ipv4.ip_nonlocal_bind=1 (README)
CW_BASE_URL=http://localhost:8080
CW_ADMINS=you@example.com
# CW_TRUSTED_PROXIES=10.66.0.1 # the reverse proxy in front (comma-separated): only its X-Forwarded-For counts
# CW_REGISTRATION=invite       # open (default) | invite | closed; overrides auth.registration
# CW_GPU_ENABLED=true          # true | false | auto (default): overrides gpu.enabled. The web service has no
                               # docker socket, so auto means no GPU there: a GPU host sets true
# CW_DOCKER_RUNTIME=runsc      # gVisor for strategy and compile containers (overrides docker.runtime); install
                               # runsc and register it in /etc/docker/daemon.json with --overlay2=none (README)
# CW_ENGINE_IMAGE=codecraft/sim            # the engine (engine.image) and the directory its image is built from
# CW_ENGINE_CONTEXT=sim                    # (engine.context): here the Python engine, the same games, slower
# CW_COMMUNITY_URL=https://discord.gg/...  # the community link (community.url): header, cover, /agents; blank = none
# CW_DISCORD_WEBHOOK=                      # the announcements channel's webhook: the worker posts first builds, the
                                           # Monday top ten and engine versions there; blank = no posts
# Hub and executors (docs/hub.md): the site on one machine, the games on others. Unset = one machine does all.
# CW_HUB_TOKEN=                # both sides: the executors' shared secret (openssl rand -hex 32)
# CW_HUB_URL=https://...       # an executor: its hub; this machine then keeps no database and serves no site
# CW_EXECUTOR_NAME=node        # an executor's name on the hub (default: the host name)
# CW_WORKER_SANDBOX=gpu        # an executor's share: true | false | gpu (only games of GPU strategies)
# CW_WORKER_BUILDS=gpu         # true | false | gpu (only GPU versions)
# CW_PARALLEL_GAMES=1          # worker.parallel_games
# CW_TELEGRAM_TOKEN=           # the hub: a bot that tells the operator when GPU work waits and no GPU machine is
# CW_TELEGRAM_CHAT=            # online (hub.gpu_alert_minutes)
# CW_DOCKER_PREFIX=cwgpu       # a second worker on the same Docker: its own container names, label and seat
# CW_DOCKER_LABEL=codecraft.gpu.game   # networks, so neither removes the other's games
# CW_SEAT_SUBNETS=10.201.0.0/16
# Sign-in mail. Without a provider the codes are printed in the web service log.
CW_RESEND_API_KEY=
CW_MAIL_FROM=CodeCraft <codecraft@your-verified-domain>
# CW_SMTP_PASSWORD=            # with mail.smtp.host/user in config.yaml
# Error monitoring (Sentry): blank = off. Unhandled exceptions and ERROR log lines of web and worker;
# request bodies are never sent, e-mail addresses and tokens are scrubbed. Leave blank on a dev box.
CW_SENTRY_DSN=
# CW_SENTRY_ENVIRONMENT=production
# Ids the server image runs with (must be able to use the docker socket)
CW_UID=1000
CW_GID=1000
DOCKER_GID=999
