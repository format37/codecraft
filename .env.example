# Copy to .env (git-ignored). docker compose reads it; the venv CLI reads the same variables from the shell.
CW_WEB_PORT=8080               # or ADDRESS:PORT to publish on one address only, e.g. 10.66.0.2:8090 (a VPN)
                               # an address that comes up after Docker needs net.ipv4.ip_nonlocal_bind=1 (README)
CW_BASE_URL=http://localhost:8080
CW_ADMINS=you@example.com
# CW_TRUSTED_PROXIES=10.66.0.1 # the reverse proxy in front (comma-separated): only its X-Forwarded-For counts
# CW_REGISTRATION=invite       # open (default) | invite | closed; overrides auth.registration
# CW_GPU_ENABLED=true          # true | false | auto (default): overrides gpu.enabled. The web service has no
                               # docker socket, so auto means no GPU there: a GPU host sets true
# CW_DOCKER_RUNTIME=runsc      # gVisor for strategy and compile containers (overrides docker.runtime); install
                               # runsc and register it in /etc/docker/daemon.json with --overlay2=none (README)
# Sign-in mail. Without a provider the codes are printed in the web service log.
CW_RESEND_API_KEY=
CW_MAIL_FROM=CodeCraft <codecraft@your-verified-domain>
# CW_SMTP_PASSWORD=            # with mail.smtp.host/user in config.yaml
# Error monitoring (Sentry): blank = off. Unhandled exceptions and ERROR log lines of web and worker;
# request bodies are never sent, e-mail addresses and tokens are scrubbed. Leave blank on a dev box.
CW_SENTRY_DSN=
# CW_SENTRY_ENVIRONMENT=production
# Ids the server image runs with (must be able to use the docker socket)
CW_UID=1000
CW_GID=1000
DOCKER_GID=999
